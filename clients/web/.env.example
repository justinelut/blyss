# =============================================================================
# Blyss web — clients/web/.env.example
#
# Copy to clients/web/.env and fill in the <replace-me> placeholders.
# Variables prefixed NEXT_PUBLIC_* are bundled into the browser bundle at
# build time. Other variables are server-side only (Next.js Node process).
# =============================================================================

# ----- Environment ----------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT=development

# ----- URLs ----------------------------------------------------------------
# Frontend (this app)
NEXT_PUBLIC_FRONTEND_BASE_URL=http://127.0.0.1:3000

# Polar API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production values (commented for reference):
#   NEXT_PUBLIC_FRONTEND_BASE_URL=https://blyss.co.ke
#   NEXT_PUBLIC_API_URL=https://api.blyss.co.ke
#   NEXT_PUBLIC_CHECKOUT_URL=https://buy.blyss.co.ke
#   NEXT_PUBLIC_PORTAL_URL=https://my.blyss.co.ke

# In dev we host the checkout + portal under the same Next.js app via path
# prefixes (/_buy, /_my). In prod, set these to the real subdomains.
NEXT_PUBLIC_CHECKOUT_URL=http://127.0.0.1:3000
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000

# Login path
NEXT_PUBLIC_LOGIN_PATH=/login

# ----- Auth cookies (server-side; must match POLAR_USER_SESSION_COOKIE_KEY) -
POLAR_AUTH_COOKIE_KEY=polar_session
POLAR_AUTH_MCP_COOKIE_KEY=polar_mcp_session

# ----- Payments: Paystack public key (browser uses this for inline widget) -
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<replace-me>

# ----- Observability (optional in dev) -------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Web Vitals reporting (sent to PostHog when the key is set)
NEXT_PUBLIC_VITALS_ENABLED=true

# Sentry source-map upload during build (optional in dev — set in prod CI)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----- Apple domain association (Stripe artifact — unused in Blyss) --------
# Polar's config has a placeholder string here. Leave the default; we don't
# use Apple Pay. Stripe code path is dormant per plan §4.4 step 5.
NEXT_PUBLIC_APPLE_DOMAIN_ASSOCIATION=

# ----- Sandbox + GitHub (Polar legacy; both disabled in Blyss) -------------
# These are kept blank because Polar's config.ts code paths read them with
# fallbacks. Removing the keys from Polar's config is part of phase 2 task
# 2.24 (frontend brand sweep).
NEXT_PUBLIC_SANDBOX_FRONTEND_BASE_URL=
NEXT_PUBLIC_GITHUB_APP_NAMESPACE=
NEXT_PUBLIC_GITHUB_BADGE_EMBED_DEFAULT_LABEL=

# ----- Checkout embed --------------------------------------------------
# Path served by Next.js to embed Paystack checkout into third-party pages.
NEXT_PUBLIC_CHECKOUT_EMBED_SCRIPT_SRC=/checkout/embed.global.js
NEXT_PUBLIC_CHECKOUT_EXTERNAL_WEBHOOKS_WAITING_LIMIT_MS=30000

# ----- Analytics ID (optional) ---------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
