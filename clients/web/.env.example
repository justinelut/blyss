# Blyss Web — Environment Variables
# Copy to .env.local for development

# --- Public (exposed to browser) ---
NEXT_PUBLIC_FRONTEND_BASE_URL=https://blyss.co.ke
NEXT_PUBLIC_API_URL=https://api.blyss.co.ke
NEXT_PUBLIC_CHECKOUT_BASE_URL=https://buy.blyss.co.ke

# --- Server-side only ---
POLAR_AUTH_COOKIE_KEY=polar_session

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PROJECT_ID=

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# MinIO / S3 (file storage)
S3_PUBLIC_IMAGES_BUCKET_HOSTNAME=cdn.blyss.co.ke
S3_PUBLIC_IMAGES_BUCKET_PROTOCOL=https
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_FILES_BUCKET=blyss-files
AWS_S3_PUBLIC_BUCKET=blyss-public

# Google Analytics and Search Console (public identifiers)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
