# =============================================================================
# Blyss — production ENV_SECRET template
#
# This file documents EVERY key the production cluster expects. It is the
# template for the GitHub Actions repo secret `ENV_SECRET` — paste the
# filled-in version of this file as the secret value at:
#   Settings → Secrets and variables → Actions → ENV_SECRET
#
# DO NOT commit the filled-in version to git. The .gitignore covers
# `.env.production` and `.env.*` — only this `.template` file is committed.
#
# Every line of this secret becomes a key in the K8s `blyss-secrets` Secret
# (deploy.yml uses `kubectl create secret generic --from-env-file=...`).
# Pods consume those keys via `envFrom: secretRef: blyss-secrets`, so the
# Polar API sees them as POLAR_* environment variables (BaseSettings).
# =============================================================================

# ----- Environment ----------------------------------------------------------
POLAR_ENV=production
POLAR_LOG_LEVEL=INFO
POLAR_TESTING=0
POLAR_SQLALCHEMY_DEBUG=0

# ----- Public URLs ----------------------------------------------------------
POLAR_FRONTEND_BASE_URL=https://blyss.co.ke
POLAR_BASE_URL=https://api.blyss.co.ke
POLAR_CHECKOUT_BASE_URL=https://api.blyss.co.ke/v1/checkout-links/{client_secret}/redirect
POLAR_USER_SESSION_COOKIE_DOMAIN=.blyss.co.ke

# CORS — the browser-side allowed origins. Must include every public host.
POLAR_CORS_ORIGINS=["https://blyss.co.ke","https://www.blyss.co.ke","https://buy.blyss.co.ke","https://my.blyss.co.ke"]
POLAR_ALLOWED_HOSTS=["blyss.co.ke","www.blyss.co.ke","api.blyss.co.ke","buy.blyss.co.ke","my.blyss.co.ke"]

# ----- Auth / sessions ------------------------------------------------------
# A 64-char secret for JWT signing + session cookies. Generate fresh:
#   python -c "import secrets; print(secrets.token_hex(64))"
POLAR_SECRET=<replace-me-128-hex-chars>
POLAR_AUTH_COOKIE_KEY=polar_session
POLAR_AUTH_MCP_COOKIE_KEY=polar_mcp_session

# ----- Runtime settings (backoffice secret overlay) -------------------------
# Fernet base64-encoded 32-byte key. Encrypts integration secrets saved via the
# backoffice /runtime-settings page (API keys, webhook secrets) at rest in the
# DB. WITHOUT this key, saving any value in the backoffice returns a 500
# (RuntimeSettingsDisabled). Generate fresh:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# NOTE: in CI this is injected from the dedicated `RUNTIME_SETTINGS_KEY` GitHub
# repo secret by deploy.yml (inject_kv), so it does NOT need to live in the
# ENV_SECRET blob. Set it here only for non-CI / manual deployments.
# Rotating this key makes all previously-saved DB secrets undecryptable — they
# must be re-entered in the backoffice afterwards.
POLAR_RUNTIME_SETTINGS_KEY=<replace-me-fernet-key>

# ----- Postgres — used by both the StatefulSet AND the API pods ------------
# IMPORTANT: changing POLAR_POSTGRES_PWD after Postgres has been initialized
# does NOT update the running DB password (the PVC keeps the old one). If the
# password drifts, run the "Cluster reset (DESTRUCTIVE)" workflow.
POLAR_POSTGRES_USER=blyss
POLAR_POSTGRES_PWD=<replace-me-strong-random>
POLAR_POSTGRES_HOST=postgres
POLAR_POSTGRES_PORT=5432
POLAR_POSTGRES_DATABASE=blyss
POLAR_POSTGRES_SSL_MODE=

# ----- Redis ---------------------------------------------------------------
POLAR_REDIS_HOST=redis
POLAR_REDIS_PORT=6379
POLAR_REDIS_DB=0

# ----- MinIO / S3 ----------------------------------------------------------
POLAR_S3_ENDPOINT_URL=http://minio:9000
POLAR_S3_ACCESS_KEY_ID=blyssadmin
POLAR_S3_SECRET_ACCESS_KEY=<replace-me-minio-password>
POLAR_S3_FILES_BUCKET_NAME=blyss-private
POLAR_S3_FILES_PUBLIC_BUCKET_NAME=blyss-public

# ----- Payments — Paystack (cards + M-Pesa via Daraja under the hood) -----
POLAR_PAYSTACK_PUBLIC_KEY=<replace-me-pk_>
POLAR_PAYSTACK_SECRET_KEY=<replace-me-sk_>
POLAR_PAYSTACK_WEBHOOK_SECRET=<replace-me>
PLATFORM_FEE_BASIS_POINTS=2000

# ----- Email — Resend (transactional) -------------------------------------
POLAR_EMAIL_SENDER=resend
POLAR_RESEND_API_KEY=<replace-me-re_>
POLAR_EMAIL_FROM=Blyss <hello@blyss.co.ke>

# ----- OAuth providers (Google + Apple kept; GitHub stripped per spec) ----
POLAR_GOOGLE_CLIENT_ID=<replace-me>
POLAR_GOOGLE_CLIENT_SECRET=<replace-me>
POLAR_APPLE_CLIENT_ID=<replace-me-or-leave-blank>
POLAR_APPLE_CLIENT_SECRET=<replace-me-or-leave-blank>

# ----- Observability (optional) -------------------------------------------
POLAR_SENTRY_DSN=
POLAR_POSTHOG_API_KEY=

# ----- Backups — Backblaze B2 (optional; backup CronJob no-ops if blank) --
POLAR_B2_KEY_ID=
POLAR_B2_APPLICATION_KEY=

# ----- Sandbox / Polar legacy (leave blank in Blyss prod) -----------------
POLAR_GITHUB_CLIENT_ID=
POLAR_GITHUB_CLIENT_SECRET=
POLAR_DISCORD_CLIENT_ID=
POLAR_DISCORD_CLIENT_SECRET=
POLAR_DISCORD_BOT_TOKEN=
POLAR_OPENAI_API_KEY=
POLAR_LOOPS_API_KEY=
POLAR_NUMERAL_API_KEY=
POLAR_STRIPE_SECRET_KEY=
POLAR_STRIPE_PUBLISHABLE_KEY=
POLAR_STRIPE_WEBHOOK_SECRET=
POLAR_STRIPE_CONNECT_WEBHOOK_SECRET=
POLAR_AWS_ACCESS_KEY_ID=
POLAR_AWS_SECRET_ACCESS_KEY=
