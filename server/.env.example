# Blyss Server — Environment Variables
# Copy to .env for development

# --- Database ---
POSTGRES_USER=blyss
POSTGRES_PASSWORD=blyss_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=blyss

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FILES_BUCKET=blyss-files
AWS_S3_PUBLIC_BUCKET=blyss-public

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_NAME=Blyss
EMAIL_FROM_ADDRESS=hello@blyss.co.ke

# --- Auth ---
SECRET=change-this-to-a-random-32-char-string
POLAR_AUTH_COOKIE_KEY=polar_session

# --- Frontend ---
FRONTEND_BASE_URL=https://blyss.co.ke
CHECKOUT_BASE_URL=https://buy.blyss.co.ke

# --- Branding ---
PLATFORM_NAME=Blyss
PLATFORM_FEE_BASIS_POINTS=2000
