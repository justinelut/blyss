# =============================================================================
# Blyss server — .env.example
#
# Copy this file to .env and fill in the <replace-me> placeholders.
# Polar reads env vars with the POLAR_ prefix (BaseSettings convention).
# Local-dev defaults point at the Docker Compose services in
# server/docker-compose.yml. Production secrets come from K8s Secrets,
# never from a checked-in file.
# =============================================================================

# ----- Environment ----------------------------------------------------------
POLAR_ENV=development
POLAR_LOG_LEVEL=DEBUG
POLAR_TESTING=0
POLAR_SQLALCHEMY_DEBUG=0
POLAR_POSTHOG_DEBUG=0

# Skip the React Email renderer build check in dev (we render emails to logger).
POLAR_SKIP_EMAIL_RENDERER_CHECK=1

# ----- URLs / hosts (dev) ---------------------------------------------------
POLAR_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
POLAR_ALLOWED_HOSTS='["localhost:3000", "127.0.0.1:3000", "localhost:8000", "127.0.0.1:8000"]'
POLAR_FRONTEND_BASE_URL="http://127.0.0.1:3000"
POLAR_BASE_URL="http://127.0.0.1:8000"
POLAR_CHECKOUT_BASE_URL="http://127.0.0.1:8000/v1/checkout-links/{client_secret}/redirect"
POLAR_USER_SESSION_COOKIE_DOMAIN="127.0.0.1"

# Production values (commented out for reference):
#   POLAR_FRONTEND_BASE_URL=https://blyss.co.ke
#   POLAR_BASE_URL=https://api.blyss.co.ke
#   POLAR_CHECKOUT_LINK_HOST=buy.blyss.co.ke
#   POLAR_USER_SESSION_COOKIE_DOMAIN=.blyss.co.ke

# ----- Auth / sessions ------------------------------------------------------
# A secret used for JWT signing + session cookies. Generate one for prod:
#   python -c "import secrets; print(secrets.token_hex(64))"
POLAR_SECRET="local-dev-only-do-not-use-in-prod-replace-me-please"

# ----- Postgres (local Docker on dedicated port to avoid collision) ---------
POLAR_POSTGRES_USER=blyss
POLAR_POSTGRES_PWD=blyss
POLAR_POSTGRES_HOST=127.0.0.1
POLAR_POSTGRES_PORT=5436
POLAR_POSTGRES_DATABASE=blyss
# Leave empty for local Docker (no SSL); set to "require" in prod
POLAR_POSTGRES_SSL_MODE=

# Read replica (optional in dev — leave commented to use the primary)
# POLAR_POSTGRES_READ_USER=
# POLAR_POSTGRES_READ_PWD=
# POLAR_POSTGRES_READ_HOST=
# POLAR_POSTGRES_READ_PORT=
# POLAR_POSTGRES_READ_DATABASE=
# POLAR_POSTGRES_READ_SSL_MODE=

# ----- Redis (local Docker on dedicated port to avoid collision) ------------
POLAR_REDIS_HOST=127.0.0.1
POLAR_REDIS_PORT=6380
POLAR_REDIS_DB=0
POLAR_REDIS_PASSWORD=
# Local Docker Redis has no TLS — must be False for local
POLAR_REDIS_SSL=False

# ----- Object storage (MinIO local; matches docker-compose) -----------------
POLAR_MINIO_USER=blyssadmin
POLAR_MINIO_PWD=blyssadmin

# In dev, S3 credentials = MinIO root credentials.
# In prod, MinIO is on K3s and these are different (per K8s secret).
POLAR_AWS_ACCESS_KEY_ID=blyssadmin
POLAR_AWS_SECRET_ACCESS_KEY=blyssadmin
POLAR_AWS_REGION=us-east-1
POLAR_S3_ENDPOINT_URL=http://127.0.0.1:9000
# Public endpoint used in presigned URLs (cdn.blyss.co.ke in prod)
POLAR_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000

# Bucket names
POLAR_S3_FILES_BUCKET_NAME=blyss-private
POLAR_S3_FILES_PUBLIC_BUCKET_NAME=blyss-public
POLAR_S3_CUSTOMER_INVOICES_BUCKET_NAME=blyss-private
POLAR_S3_PAYOUT_INVOICES_BUCKET_NAME=blyss-private

# ----- Email --------------------------------------------------------------
# In dev: "logger" prints magic-link codes to API stdout.
# Run `python dev/email_login_code_notifier.py` in a 4th terminal to surface them.
# In prod: "resend" + RESEND_API_KEY.
POLAR_EMAIL_SENDER=logger
POLAR_RESEND_API_KEY=
POLAR_EMAIL_FROM_NAME=Blyss
POLAR_EMAIL_FROM_DOMAIN=notifications.blyss.co.ke
POLAR_EMAIL_FROM_LOCAL=mail
POLAR_EMAIL_DEFAULT_REPLY_TO_NAME="Blyss Support"
POLAR_EMAIL_DEFAULT_REPLY_TO_EMAIL_ADDRESS=support@blyss.co.ke

# ----- Payments: Paystack (cards + M-Pesa) ---------------------------------
# Get test keys from https://dashboard.paystack.com (developer mode)
POLAR_PAYSTACK_SECRET_KEY=<replace-me>
POLAR_PAYSTACK_PUBLIC_KEY=<replace-me>
POLAR_PAYSTACK_WEBHOOK_SECRET=<replace-me>

# ----- Payments: Stripe (DORMANT — kept for upstream compatibility) --------
# Polar's Stripe code path is unused on the marketplace surface.
# These dummy values prevent boot failures from missing required strings.
POLAR_STRIPE_SECRET_KEY=sk_test_dummy_stripe_key_unused_in_blyss
POLAR_STRIPE_PUBLISHABLE_KEY=pk_test_dummy_stripe_key_unused_in_blyss
POLAR_STRIPE_WEBHOOK_SECRET=whsec_dummy_unused_in_blyss
POLAR_STRIPE_CONNECT_WEBHOOK_SECRET=whsec_dummy_unused_in_blyss

# ----- Branding (overrides Polar defaults; user replaces images at launch) -
POLAR_FAVICON_URL=https://cdn.blyss.co.ke/brand/favicon.png
POLAR_THUMBNAIL_URL=https://cdn.blyss.co.ke/brand/og-default.png
POLAR_INVOICES_ADDITIONAL_INFO=[support@blyss.co.ke](mailto:support@blyss.co.ke)

# ----- Currency + fees (Blyss defaults) ------------------------------------
POLAR_DEFAULT_CURRENCY=kes
POLAR_PLATFORM_FEE_BASIS_POINTS=2000
POLAR_PLATFORM_FEE_FIXED=40

# ----- OAuth providers (optional in dev — leave blank to skip) -------------
POLAR_GOOGLE_CLIENT_ID=
POLAR_GOOGLE_CLIENT_SECRET=

# Apple Sign In (optional in dev)
POLAR_APPLE_CLIENT_ID=
POLAR_APPLE_TEAM_ID=
POLAR_APPLE_KEY_ID=
POLAR_APPLE_KEY_VALUE=

# GitHub OAuth (DELETED FROM UI — these stay blank, never used)
POLAR_GITHUB_CLIENT_ID=
POLAR_GITHUB_CLIENT_SECRET=
POLAR_GITHUB_REPOSITORY_BENEFITS_APP_NAMESPACE=
POLAR_GITHUB_REPOSITORY_BENEFITS_APP_IDENTIFIER=
POLAR_GITHUB_REPOSITORY_BENEFITS_APP_PRIVATE_KEY=
POLAR_GITHUB_REPOSITORY_BENEFITS_CLIENT_ID=
POLAR_GITHUB_REPOSITORY_BENEFITS_CLIENT_SECRET=

# Discord (optional — used if creators add Discord links as markdown perks)
POLAR_DISCORD_CLIENT_ID=
POLAR_DISCORD_CLIENT_SECRET=
POLAR_DISCORD_BOT_TOKEN=

# ----- Marketing email (Loops) ---------------------------------------------
# Loops syncs creator + customer audiences. Leave empty in dev = sync is no-op.
POLAR_LOOPS_API_KEY=

# ----- Observability (optional in dev) -------------------------------------
POLAR_SENTRY_DSN=
POLAR_POSTHOG_PROJECT_API_KEY=

# ----- Search indexing (optional in dev) -----------------------------------
INDEXNOW_KEY=

# ----- Disabled / unused services (leave blank; do not remove these keys) --
POLAR_NUMERAL_API_KEY=
POLAR_LOGFIRE_TOKEN=
POLAR_LOGO_DEV_PUBLISHABLE_KEY=
POLAR_PLAIN_REQUEST_SIGNING_SECRET=
POLAR_PLAIN_TOKEN=
POLAR_PLAIN_CHAT_SECRET=
POLAR_CHARGEBACK_STOP_WEBHOOK_SECRET=
POLAR_AI_PROVIDER=gemini
POLAR_OPENAI_API_KEY=
# Set a placeholder so the analyzer module imports without raising; actual AI
# review calls won't work in dev (and we don't need them for marketplace work).
POLAR_GOOGLE_AI_API_KEY=__UNSET_DEV_PLACEHOLDER__

# Tinybird (deleted from repo per phase 2 §4.7 — these stay blank)
POLAR_TINYBIRD_API_TOKEN=
POLAR_TINYBIRD_READ_TOKEN=
POLAR_TINYBIRD_CLICKHOUSE_TOKEN=
POLAR_TINYBIRD_WORKSPACE=
POLAR_TINYBIRD_EVENTS_WRITE=False
POLAR_TINYBIRD_EVENTS_READ=False
